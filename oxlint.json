{
  "$schema": "https://raw.githubusercontent.com/nicolo-ribaudo/oxc-config-schema/refs/heads/main/schema.json",
  "plugins": ["typescript", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "warn",
    "nursery": "off"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "typescript/no-explicit-any": "warn",
    "typescript/no-non-null-assertion": "warn",
    "import/no-duplicates": "error"
  },
  "ignorePatterns": ["node_modules", "dist", "*.json"]
}
