{
  "name": "cacoo-cli-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "lint": "oxlint --tsconfig ./tsconfig.json .",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "oxlint": "^0.16.6",
    "typescript": "^5.8.2"
  }
}
